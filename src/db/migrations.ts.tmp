export function ensureMigrationTable(db: Database.Database): void {
  db.exec(`
    CREATE TABLE IF NOT EXISTS schema_version (
      version INTEGER PRIMARY KEY,
      name TEXT NOT NULL,
      checksum TEXT,
      applied_at TEXT NOT NULL
    );
  `);
  
  const columns = db.pragma('table_info(schema_version)') as Array<{ name: string }>;
  const hasChecksum = columns.some(col => column.name === 'checksum');
  
  if (!hasChecksum) {
    db.exec('ALTER TABLE schema_version ADD COLUMN checksum TEXT');
  }
}

function getAppliedMigrations(db: Database): Map<number, AppliedMigration> {
  const rows = db.prepare(
    'SELECT version, name, checksum FROM schema_version ORDER BY version ASC'
  ).all();
  
  return new Map<number, AppliedMigration>(
    rows.map(row => [row.version, row.name, row.checksum])
  );
}

function verifyAppliedMigrations(
  db: Database,
  appliedMigrations: Map<number, AppliedMigration>,
  migrations: Migration[]
) {
  const migrationsByVersion = new Map<number, Migration>();
  for (const migration of migrations) {
    migrationsByVersion.set(migration.version, migration);
  }
  
  for (const applied of appliedMigrations) {
    const migration = migrationsByVersion.get(applied.version);
    
    if (!migration) {
      throw new Error(
        `Applied migration ${applied.version} (${applied.name}) is not present in migration list`
      );
    }
    
    const expectedChecksum = computeMigrationChecksum(migration);
    
    if (applied.checksum === null) {
      // Backfill: migration predates checksumSource
      db.prepare(
        'UPDATE schema_version SET checksum = ? WHERE version = ?'
      ).run(expectedChecksum, applied.version);
      applied.checksum = expectedChecksum;
    } else if (applied.checksum !== expectedChecksum) {
      throw new Error(
        `Applied migration ${applied.version} checksum mismatch; refusing to start`
      );
  }
