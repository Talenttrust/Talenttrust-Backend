{
  "name": "talenttrust-backend",
  "version": "1.0.0",
  "description": "TalentTrust API: milestone escrow API backed by a Soroban contract on Stellar",
  "main": "dist/src/index.js",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/index.js",
    "dev": "ts-node src/index.ts",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "jest",
    "apikey:new": "ts-node scripts/new-api-key.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "dependencies": {
    "@stellar/stellar-sdk": "^13.3.0",
    "compression": "^1.8.2",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "helmet": "^7.2.0",
    "lru-cache": "^11.5.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^10.1.1",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.17.0",
    "@types/supertest": "^6.0.2",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "jest": "^29.7.0",
    "jose": "^4.15.9",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "roots": ["<rootDir>/tests"],
    "setupFiles": ["<rootDir>/tests/jest.setup.js", "<rootDir>/tests/setup/network-guard.ts"]
  }
}
