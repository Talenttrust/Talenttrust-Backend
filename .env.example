PORT=3001
# Wallet auth: secret used to sign challenges and JWTs (>= 32 bytes). Setting it makes a bearer
# token mandatory on mutating routes; AUTH_REQUIRED=true also enforces auth (with a per-process secret).
AUTH_SECRET=
# AUTH_REQUIRED=true
# Secret used to sign contract-list pagination cursors. Defaults to HMAC-SHA256(AUTH_SECRET, "cursor")
# when AUTH_SECRET is set, or an ephemeral per-process secret otherwise (warns in production).
# CURSOR_SECRET=
# Soroban escrow contract (defaults to the TalentTrust testnet deployment)
ESCROW_CONTRACT_ID=CCZMIVUBMG5SBC47SDTC32RWLBJ2HW2DCFVWJEOKCH2IFJBZGBKTXK5W
STELLAR_NETWORK=testnet
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
# Optional override; defaults to the public network passphrase for STELLAR_NETWORK
# STELLAR_NETWORK_PASSPHRASE=
# Maximum run duration in milliseconds per indexer batch (default 8000)
# INDEXER_MAX_RUN_MS=8000
# Maximum event pages fetched per indexer run (default 5)
# INDEXER_MAX_PAGES=5
# Transaction timebounds for /api/v1/tx/build (seconds, default 300)
TX_TIMEOUT_SECONDS=300
FRONTEND_URL=https://talenttrust-frontend.vercel.app
# Set to true to require an Idempotency-Key header on every POST under /api/v1
IDEMPOTENCY_REQUIRED=false
# Ed25519 signing secret (Stellar S... secret seed) for signing contract state receipts
# RECEIPT_SIGNING_SECRET=SD...
# Secret used by the daily expiry sweep endpoint (/api/cron/expire-contracts)
CRON_SECRET=replace-with-a-long-random-secret
# Set to true to require If-Match on contract mutations (428 when missing)
REQUIRE_IF_MATCH=false
# Admin dispute queue (GET /api/v1/disputes*): while unset those routes return 404
# ADMIN_READ_TOKEN=
# SLA for open disputes, in hours (default 72)
DISPUTE_SLA_HOURS=72
# Maximum request body size (default 100kb)
BODY_LIMIT=100kb
# Bayesian prior weight for the reputation leaderboard score (default 5)
REPUTATION_PRIOR_WEIGHT=5
# Live chain status on GET /api/v1/chain
RPC_TIMEOUT_MS=4000
CHAIN_STATUS_TTL_MS=15000
CHAIN_REFRESH_MIN_INTERVAL_MS=5000
# Recent relayed transactions remembered for GET /api/v1/tx
TX_CACHE_MAX=200
# Cache TTL for /api/v1/chain/contracts and /api/v1/chain/reputation reads
CHAIN_READ_TTL_MS=5000
# Maximum audit entries retained in memory (positive integer, default 100000)
AUDIT_MAX_ENTRIES=100000
# Webhook subscription management (disabled while unset). Delivery is HTTPS-only except http://localhost outside production.
# WEBHOOK_ADMIN_TOKEN=
# Comma-separated CORS origin allowlist, added to FRONTEND_URL (+ local dev origins outside production)
# CORS_ORIGINS=https://app.example.com,https://staging.example.com
# Event indexer: poll interval for the long-running server (0/unset = off; Vercel uses the cron) and start ledger
INDEXER_INTERVAL_MS=0
# Starting ledger for event indexer (default 0 or latest - 17280)
# INDEXER_START_LEDGER=
# Scoped API keys (JSON array of {id, hash: "sha256:<hex>", scopes, expiresAt?}); create one with `npm run apikey:new -- ops-1 disputes:resolve`.
# Optional expiresAt (ISO 8601, e.g. "2027-01-31T00:00:00Z"): the key is rejected with 401 from then on; add `--expires-in-days 30` to generate one.
# Required in production for dispute resolution.
# API_KEYS=[]
# Readiness probe (/health/ready): per-check timeout and result cache (ms)
HEALTH_CHECK_TIMEOUT_MS=2000
HEALTH_CACHE_MS=10000
# Optional JSON snapshot persistence for self-hosted deployments (not used on Vercel)
# STORE_SNAPSHOT_PATH=./data/store-snapshot.json
STORE_SNAPSHOT_INTERVAL_MS=30000
# Logging verbosity (debug, info, warn, error, silent; default info in production, silent in test)
# LOG_LEVEL=
# Metrics endpoint authentication (Bearer token for GET /metrics)
# METRICS_TOKEN=
# Secret for signing pagination cursors (defaults to random per-process if unset)
# CURSOR_SECRET=
# Operator override: set to true to force the API into paused mode (503 on guarded routes)
# API_PAUSED=false
# Pause guard cache TTL (milliseconds, default 10000)
# PAUSE_CHECK_TTL_MS=10000
# Pause guard failure mode when RPC check fails (open or closed, default open)
# PAUSE_FAIL_MODE=open
# Set to false to skip on-chain is_paused probe (tests, offline dev)
# PAUSE_CHECK_CHAIN=true
# HTTP server keep-alive timeout (milliseconds, default 65000)
# KEEP_ALIVE_TIMEOUT_MS=65000
# HTTP server headers timeout (milliseconds, default 66000)
# HEADERS_TIMEOUT_MS=66000
# HTTP server request timeout (milliseconds, default 30000)
# REQUEST_TIMEOUT_MS=30000
# Graceful shutdown timeout (milliseconds, default 10000)
# SHUTDOWN_GRACE_MS=10000
# Maximum SSE connections (default 100)
# SSE_MAX_CONNECTIONS=100
# Time budget for parity reconciliation in cron endpoint (milliseconds, default 25000)
# PARITY_RECONCILE_TIME_BUDGET_MS=25000

# Rate limiting (applied per client IP; set RATE_LIMIT_ENABLED=false to disable globally)
# Default policy covers all /api/v1 routes not covered by a more specific policy (default 120/min)
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_DEFAULT_PER_MIN=120
# Auth policy: POST /api/v1/auth/token (brute-force protection, default 20/min)
# RATE_LIMIT_AUTH_PER_MIN=20
# Tx policy: POST /api/v1/tx/build and POST /api/v1/tx/submit (default 60/min)
# RATE_LIMIT_TX_PER_MIN=60
# Chain read policy: GET /api/v1/chain/contracts and /chain/reputation (default 60/min, preserves existing behaviour)
# RATE_LIMIT_CHAIN_PER_MIN=60
# Seed demo escrow contracts on startup when using the default in-memory store (set to false to start empty)
SEED_DEMO_DATA=true
