PORT=3001
# Wallet auth: secret used to sign challenges and JWTs (>= 32 bytes). Setting it makes a bearer
# token mandatory on mutating routes; AUTH_REQUIRED=true also enforces auth (with a per-process secret).
AUTH_SECRET=
# AUTH_REQUIRED=true
# Soroban escrow contract (defaults to the TalentTrust testnet deployment)
ESCROW_CONTRACT_ID=CCZMIVUBMG5SBC47SDTC32RWLBJ2HW2DCFVWJEOKCH2IFJBZGBKTXK5W
STELLAR_NETWORK=testnet
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
# Optional override; defaults to the public network passphrase for STELLAR_NETWORK
# STELLAR_NETWORK_PASSPHRASE=
# Transaction timebounds for /api/v1/tx/build (seconds, default 300)
TX_TIMEOUT_SECONDS=300
FRONTEND_URL=https://talenttrust-frontend.vercel.app
# Set to true to require an Idempotency-Key header on every POST under /api/v1
IDEMPOTENCY_REQUIRED=false
# Ed25519 signing secret (Stellar S... secret seed) for signing contract state receipts
# RECEIPT_SIGNING_SECRET=SD...
# Secret used by the daily expiry sweep endpoint (/api/cron/expire-contracts)
CRON_SECRET=replace-with-a-long-random-secret
# Set to true to require If-Match on contract mutations (428 when missing)
REQUIRE_IF_MATCH=false
