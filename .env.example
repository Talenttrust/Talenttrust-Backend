PORT=3001
# Wallet auth: secret used to sign challenges and JWTs (>= 32 bytes). Setting it makes a bearer
# token mandatory on mutating routes; AUTH_REQUIRED=true also enforces auth (with a per-process secret).
AUTH_SECRET=
# AUTH_REQUIRED=true
# Soroban escrow contract (defaults to the TalentTrust testnet deployment)
ESCROW_CONTRACT_ID=CCZMIVUBMG5SBC47SDTC32RWLBJ2HW2DCFVWJEOKCH2IFJBZGBKTXK5W
STELLAR_NETWORK=testnet
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
# Optional override; defaults to the public network passphrase for STELLAR_NETWORK
# STELLAR_NETWORK_PASSPHRASE=
# Transaction timebounds for /api/v1/tx/build (seconds, default 300)
TX_TIMEOUT_SECONDS=300
FRONTEND_URL=https://talenttrust-frontend.vercel.app
# Set to true to require an Idempotency-Key header on every POST under /api/v1
IDEMPOTENCY_REQUIRED=false
# Ed25519 signing secret (Stellar S... secret seed) for signing contract state receipts
# RECEIPT_SIGNING_SECRET=SD...
# Secret used by the daily expiry sweep endpoint (/api/cron/expire-contracts)
CRON_SECRET=replace-with-a-long-random-secret
# Set to true to require If-Match on contract mutations (428 when missing)
REQUIRE_IF_MATCH=false
# Admin dispute queue (GET /api/v1/disputes*): while unset those routes return 404
# ADMIN_READ_TOKEN=
# SLA for open disputes, in hours (default 72)
DISPUTE_SLA_HOURS=72
# Maximum request body size (default 100kb)
BODY_LIMIT=100kb
# Bayesian prior weight for the reputation leaderboard score (default 5)
REPUTATION_PRIOR_WEIGHT=5
# Live chain status on GET /api/v1/chain
RPC_TIMEOUT_MS=4000
CHAIN_STATUS_TTL_MS=15000
CHAIN_REFRESH_MIN_INTERVAL_MS=5000
# Recent relayed transactions remembered for GET /api/v1/tx
TX_CACHE_MAX=200
# Cache TTL for /api/v1/chain/contracts and /api/v1/chain/reputation reads
CHAIN_READ_TTL_MS=5000
# Webhook subscription management (disabled while unset). Delivery is HTTPS-only except http://localhost outside production.
# WEBHOOK_ADMIN_TOKEN=
# Comma-separated CORS origin allowlist, added to FRONTEND_URL (+ local dev origins outside production)
# CORS_ORIGINS=https://app.example.com,https://staging.example.com
# Event indexer: poll interval for the long-running server (0/unset = off; Vercel uses the cron) and start ledger
INDEXER_INTERVAL_MS=0
# INDEXER_START_LEDGER=
# Scoped API keys (JSON array of {id, hash: "sha256:<hex>", scopes}); create one with `npm run apikey:new -- ops-1 disputes:resolve`.
# Required in production for dispute resolution.
# API_KEYS=[]
# Readiness probe (/health/ready): per-check timeout and result cache (ms)
HEALTH_CHECK_TIMEOUT_MS=2000
HEALTH_CACHE_MS=10000

# Rate limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_READ_PER_MIN=120
RATE_LIMIT_WRITE_PER_MIN=20
TRUST_PROXY=
